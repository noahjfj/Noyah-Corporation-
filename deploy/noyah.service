[Unit]
Description=Noyah Corporation - agent IA
After=network-online.target
Wants=network-online.target

[Service]
User=noyah
WorkingDirectory=/opt/noyah-corporation
ExecStart=/opt/noyah-corporation/node_modules/.bin/tsx src/server.ts
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/noyah-corporation/data

[Install]
WantedBy=multi-user.target
