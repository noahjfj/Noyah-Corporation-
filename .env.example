# Copie ce fichier en .env sur le VPS (jamais dans Git) et remplis les valeurs.

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- WhatsApp Cloud API (developers.facebook.com > ton app > WhatsApp) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Clé secrète de l'app (Paramètres de l'app > Général), sert à vérifier que les messages viennent bien de Meta
WHATSAPP_APP_SECRET=
# Mot de passe libre que tu choisis, à recopier dans la config du webhook chez Meta
WHATSAPP_VERIFY_TOKEN=
# Ton numéro perso, format international sans + (ex : 32470123456). L'agent ignore tous les autres.
OWNER_WHATSAPP_NUMBER=

# --- Outlook (portal.azure.com > Inscriptions d'applications) ---
MS_CLIENT_ID=
# "consumers" pour un compte Outlook perso (outlook.fr, hotmail...), "common" sinon
MS_TENANT=consumers

# --- Divers ---
TIMEZONE=Europe/Brussels
PORT=3000
